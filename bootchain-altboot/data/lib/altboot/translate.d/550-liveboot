#!/bin/bash -efu

# ALT-specific
case "$STAGENAME" in
altinst)
	# ALT Linux Installer
	RESCUE=
	LIVE=
	;;

rescue)	# ALT Rescue LiveCD
	RESCUE=1
	LIVE=1
	;;

live)	# ALT Linux LiveCD
	RESCUE=
	LIVE=1
	;;

*)	# For other stage names, just add the appropriate flags
	RESCUE="${RESCUE-}"
	LIVE="${LIVE-}"
	;;
esac

VALUE=
[ -z "$LIVE" ] ||
	VALUE=live_ro
[ -z "$RESCUE" ] ||
	VALUE="${VALUE:+$VALUE,}rescue"
ALTBOOT_LIVEBOOT0="method=${method};squash=${STAGENAME}${overlays:+;$overlays}"
